{
  "tile_id": "01K7A000000000000000000011",
  "authorMode": "manual",
  "title": "Events over time by service",
  "tileType": "code",
  "chartType": "timeseries",
  "chartQuery": "SELECT DATE_TRUNC('minute', \"p_timestamp\") AS time_bucket, \"service\", COUNT(*) AS events FROM \"app-logs\" GROUP BY time_bucket, \"service\" ORDER BY time_bucket ASC",
  "dbName": ["app-logs"],
  "config": {
    "type": "bar",
    "colourScheme": "classic",
    "layout": {
      "legendPosition": "bottom",
      "segments": {
        "value": [10, 90],
        "isPercent": true
      },
      "label": false,
      "stacked": true
    },
    "axes": {
      "x": {
        "field": "time_bucket",
        "title": "time_bucket",
        "display": true
      },
      "y": {
        "field": "events",
        "title": "events",
        "display": true,
        "beginAtZero": true
      },
      "groupBy": {
        "field": ["service"]
      }
    },
    "advanced": {
      "dataLabels": {
        "enabled": false
      },
      "tooltip": {
        "enabled": true,
        "mode": "index",
        "intersect": false
      }
    }
  },
  "layout": {
