+// queryAlertValue runs an alert's query over its rolling evaluation window and
+// returns the single aggregate value it produces.
+func queryAlertValue(ctx context.Context, query string, window time.Duration) (float64, error) {
+	endTime := time.Now()
+	status, body, err := postQueryFeatureContext(ctx, "api/v1/query", map[string]string{
+		"query":     query,
+		"startTime": endTime.Add(-window).Format(time.RFC3339Nano),
+		"endTime":   endTime.Format(time.RFC3339Nano),
+	})
+	if err != nil {
+		return 0, err
+	}
+	if err := readiness.HTTPStatus("alert query", status, string(body)); err != nil {
+		return 0, err
+	}
+	var rows []map[string]any
+	if err := json.Unmarshal(body, &rows); err != nil {
+		return 0, fmt.Errorf("decode alert query response %s: %w", body, err)
+	}
+	if len(rows) != 1 || len(rows[0]) != 1 {
+		return 0, fmt.Errorf("alert query returned %s, want one row with one value", body)
+	}
+	for _, value := range rows[0] {
+		if number, ok := value.(float64); ok {
+			return number, nil
+		}
+	}
+	return 0, fmt.Errorf("alert query returned non-numeric value: %s", body)
+}
+
+// waitForAlertQueryValue waits until the query in alertBody returns expected
+// over the alert's rolling window. On timeout it logs and returns so the
+// evaluation and state assertions report the failure as before; permanent
+// errors fail at once.
+func waitForAlertQueryValue(t *testing.T, alertBody string, expected float64, timeout, interval, attemptTimeout time.Duration) {
+	t.Helper()
+	var config testAlertQueryConfig
+	require.NoError(t, json.Unmarshal([]byte(alertBody), &config))
+	window, err := time.ParseDuration(config.EvalConfig.RollingWindow.EvalStart)
+	require.NoErrorf(t, err, "unsupported alert evalStart %q", config.EvalConfig.RollingWindow.EvalStart)
+
+	lastReason := ""
+	opts := readiness.Options{
+		Timeout:        timeout,
+		Interval:       interval,
+		AttemptTimeout: attemptTimeout,
+		OnRetry: func(attempt int, err error) {
+			if reason := err.Error(); reason != lastReason {
+				t.Logf("alert query not ready (attempt %d): %s", attempt, reason)
+				lastReason = reason
+			}
+		},
+	}
+	attempts, err := readiness.Wait(context.Background(), opts, func(ctx context.Context) error {
+		value, err := queryAlertValue(ctx, config.Query, window)
+		if err != nil {
+			return err
+		}
+		if value != expected {
+			return fmt.Errorf("alert query returned %v, want %v", value, expected)
+		}
+		return nil
+	})
+	if readiness.IsPermanent(err) {
+		t.Fatalf("alert query readiness check failed permanently: %v", err)
+	}
+	if err != nil {
+		t.Logf("continuing to alert evaluation after readiness wait: %v", err)
+		return
+	}
+	t.Logf("alert query ready after %d attempts", attempts)
+}
