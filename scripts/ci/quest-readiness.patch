+package readiness
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+// fakeClock advances only when the poller sleeps.
+type fakeClock struct {
+	current time.Time
+	sleeps  []time.Duration
+}
+
+func (c *fakeClock) options(timeout, interval time.Duration) Options {
+	return Options{
+		Timeout:        timeout,
+		Interval:       interval,
+		AttemptTimeout: time.Minute,
+		now:            func() time.Time { return c.current },
+		sleep: func(ctx context.Context, d time.Duration) error {
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			c.sleeps = append(c.sleeps, d)
+			c.current = c.current.Add(d)
+			return nil
+		},
+	}
+}
+
+func newFakeClock() *fakeClock {
+	return &fakeClock{current: time.Unix(1_700_000_000, 0)}
+}
+
+func TestWaitReturnsOnceReady(t *testing.T) {
+	// Verifies polling stops at the first successful check.
+	clock := newFakeClock()
+	calls := 0
+	var retried []int
+	opts := clock.options(time.Minute, 5*time.Second)
+	opts.OnRetry = func(attempt int, err error) { retried = append(retried, attempt) }
+
+	attempts, err := Wait(context.Background(), opts, func(context.Context) error {
+		calls++
+		if calls < 3 {
+			return fmt.Errorf("only %d of 100 records", calls*10)
+		}
+		return nil
+	})
+
+	require.NoError(t, err)
+	require.Equal(t, 3, attempts)
+	require.Equal(t, []int{1, 2}, retried)
+	require.Equal(t, []time.Duration{5 * time.Second, 5 * time.Second}, clock.sleeps)
+}
+
+func TestWaitStopsOnPermanentError(t *testing.T) {
+	// Verifies permanent failures such as rejected credentials are not retried.
+	clock := newFakeClock()
+	calls := 0
+	rejected := errors.New("401 unauthorized")
+
+	attempts, err := Wait(context.Background(), clock.options(time.Minute, time.Second), func(context.Context) error {
+		calls++
+		return Permanent(rejected)
+	})
+
+	require.ErrorIs(t, err, rejected)
+	require.True(t, IsPermanent(err))
+	require.Equal(t, 1, attempts)
+	require.Equal(t, 1, calls)
+	require.Empty(t, clock.sleeps)
+}
+
+func TestWaitMakesFinalAttemptAtDeadline(t *testing.T) {
+	// Verifies the wait never gives up before the bound an equivalent fixed sleep used.
+	clock := newFakeClock()
+	start := clock.current
+	var attemptTimes []time.Duration
+	notReady := errors.New("count is 49, want 50")
+
+	attempts, err := Wait(context.Background(), clock.options(120*time.Second, 50*time.Second), func(context.Context) error {
+		attemptTimes = append(attemptTimes, clock.current.Sub(start))
+		return notReady
+	})
+
+	var timeout *TimeoutError
+	require.ErrorAs(t, err, &timeout)
+	require.ErrorIs(t, err, notReady)
+	require.False(t, IsPermanent(err))
+	require.Equal(t, 4, attempts)
+	require.Equal(t, timeout.Attempts, attempts)
+	require.Equal(t, 120*time.Second, timeout.Elapsed)
+	require.Equal(t, []time.Duration{0, 50 * time.Second, 100 * time.Second, 120 * time.Second}, attemptTimes)
+	require.Equal(t, []time.Duration{50 * time.Second, 50 * time.Second, 20 * time.Second}, clock.sleeps)
+}
+
+func TestWaitSucceedsOnFinalAttempt(t *testing.T) {
+	// Verifies data that becomes ready exactly at the deadline is accepted.
+	clock := newFakeClock()
+	start := clock.current
+
+	attempts, err := Wait(context.Background(), clock.options(180*time.Second, 60*time.Second), func(context.Context) error {
+		if clock.current.Sub(start) < 180*time.Second {
+			return errors.New("not yet persisted")
+		}
+		return nil
+	})
+
+	require.NoError(t, err)
+	require.Equal(t, 4, attempts)
+}
+
+func TestWaitHonoursCancellation(t *testing.T) {
+	// Verifies a cancelled context ends the wait instead of polling to the deadline.
+	clock := newFakeClock()
+	ctx, cancel := context.WithCancel(context.Background())
+	calls := 0
+
+	_, err := Wait(ctx, clock.options(time.Hour, time.Second), func(context.Context) error {
+		calls++
+		if calls == 2 {
+			cancel()
+		}
+		return errors.New("not ready")
+	})
+
+	require.ErrorIs(t, err, context.Canceled)
+	require.Equal(t, 2, calls)
+}
+
+func TestWaitRejectsInvalidOptions(t *testing.T) {
+	// Verifies a missing bound cannot silently skip the check or leave it unbounded.
+	for _, opts := range []Options{
+		{Interval: time.Second, AttemptTimeout: time.Second},
+		{Timeout: time.Second, AttemptTimeout: time.Second},
+		{Timeout: time.Second, Interval: time.Second},
+	} {
+		_, err := Wait(context.Background(), opts, func(context.Context) error { return nil })
+		require.Error(t, err, "%+v", opts)
+	}
+}
+
+func TestWaitWithRealClock(t *testing.T) {
+	// Verifies the default timer-based sleep respects the bound.
+	startedAt := time.Now()
+	attempts, err := Wait(context.Background(), Options{Timeout: 30 * time.Millisecond, Interval: 10 * time.Millisecond, AttemptTimeout: time.Second}, func(context.Context) error {
+		return errors.New("never ready")
+	})
+	require.Error(t, err)
+	require.GreaterOrEqual(t, attempts, 2)
+	require.GreaterOrEqual(t, time.Since(startedAt), 30*time.Millisecond)
+}
+
+func TestWaitBoundsStalledAttempts(t *testing.T) {
+	// Verifies each attempt gets a deadline, so stalled I/O that honours its
+	// context is retried, and the whole wait ends within Timeout + AttemptTimeout.
+	const timeout, attemptTimeout = 150 * time.Millisecond, 40 * time.Millisecond
+	startedAt := time.Now()
+	attempts := 0
+	_, err := Wait(context.Background(), Options{Timeout: timeout, Interval: 10 * time.Millisecond, AttemptTimeout: attemptTimeout}, func(ctx context.Context) error {
+		attempts++
+		deadline, ok := ctx.Deadline()
+		require.True(t, ok)
+		require.LessOrEqual(t, time.Until(deadline), attemptTimeout)
+		<-ctx.Done() // a request that never answers
+		return ctx.Err()
+	})
+	elapsed := time.Since(startedAt)
+
+	var timeoutErr *TimeoutError
+	require.ErrorAs(t, err, &timeoutErr)
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.False(t, IsPermanent(err))
+	require.GreaterOrEqual(t, attempts, 3)
+	require.GreaterOrEqual(t, elapsed, timeout)
+	require.Less(t, elapsed, timeout+attemptTimeout+100*time.Millisecond)
+}
+
+func TestWaitFinalAttemptRunsPastDeadline(t *testing.T) {
+	// Verifies the attempt starting at the deadline gets its full AttemptTimeout.
+	const timeout = 60 * time.Millisecond
+	startedAt := time.Now()
+	attempts, err := Wait(context.Background(), Options{Timeout: timeout, Interval: time.Hour, AttemptTimeout: time.Second}, func(ctx context.Context) error {
+		if time.Since(startedAt) < timeout {
+			return errors.New("not yet")
+		}
+		select {
+		case <-time.After(50 * time.Millisecond): // slow but within its own bound
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	})
+	require.NoError(t, err)
+	require.Equal(t, 2, attempts)
+}
+
+func TestHTTPStatus(t *testing.T) {
+	// Verifies only credential and permission failures are permanent.
+	require.NoError(t, HTTPStatus("counts", 200, ""))
+
+	for _, status := range []int{401, 403} {
+		err := HTTPStatus("counts", status, "denied")
+		require.Error(t, err)
+		require.True(t, IsPermanent(err), "status %d", status)
+	}
+
+	for _, status := range []int{400, 404, 500, 502, 503} {
+		err := HTTPStatus("counts", status, "stream not found")
+		require.Error(t, err)
+		require.False(t, IsPermanent(err), "status %d", status)
+		require.Contains(t, err.Error(), fmt.Sprint(status))
+	}
+}
+
+func TestCommandFailure(t *testing.T) {
+	// Verifies pb authentication failures stop polling while other failures retry.
+	cause := errors.New("exit status 1")
+	require.NoError(t, CommandFailure("pb sql run", nil, "", ""))
+
+	err := CommandFailure("pb sql run", cause, "", "Error: 401 Unauthorized")
+	require.ErrorIs(t, err, cause)
+	require.True(t, IsPermanent(err))
+
+	err = CommandFailure("pb sql run", cause, "request failed: 403 Forbidden", "")
+	require.True(t, IsPermanent(err))
+
+	// pb v1.0.1 prints a JSON envelope after its progress spinner.
+	spinner := "| fetching...\x1b[K"
+	for _, permanent := range []string{
+		`{"error":{"code":"AUTH_FAILED","message":"query failed: server returned 401 Unauthorized","http_status":401,"retryable":false}}`,
+		`{"error":{"code":"PERMISSION_DENIED","message":"query failed: server returned 403 Forbidden","http_status":403,"retryable":false}}`,
+	} {
+		err = CommandFailure("pb sql run", cause, spinner+permanent, "")
+		require.True(t, IsPermanent(err), permanent)
+	}
+	// A dataset the querier has not synced yet is retried even though pb
+	// itself reports it as non-retryable.
+	for _, transient := range []string{
+		`{"error":{"code":"NOT_FOUND","message":"query failed: server returned 404 Not Found","http_status":404,"retryable":false}}`,
+		`{"error":{"code":"SERVER_ERROR","message":"query failed: server returned 500 Internal Server Error","http_status":500,"retryable":true}}`,
+		`{"error":{"code":"QUERY_FAILED","message":"Forbidden is a word in this table name","http_status":400}}`,
+	} {
+		err = CommandFailure("pb sql run", cause, "", spinner+transient)
+		require.False(t, IsPermanent(err), transient)
+	}
+
+	// Generated stream names may contain digit runs that look like status codes.
+	err = CommandFailure("pb sql run", cause, "", "table 'ci4013a403' not found")
+	require.ErrorIs(t, err, cause)
+	require.False(t, IsPermanent(err))
+}
+
+func TestMissing(t *testing.T) {
+	// Verifies record matching treats partial, duplicated and extra rows as multisets.
+	expected := []string{"a", "b", "b", "c"}
+
+	require.Equal(t, expected, Missing(expected, nil))
+	require.Equal(t, []string{"b", "c"}, Missing(expected, []string{"b", "a"}))
+	require.Equal(t, []string{"b"}, Missing(expected, []string{"c", "b", "a", "a"}))
+	require.Empty(t, Missing(expected, []string{"c", "b", "z", "a", "b"}))
+	require.Empty(t, Missing[string](nil, []string{"a"}))
+}
