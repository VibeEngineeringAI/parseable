+// waitForPersistedFlogs polls object storage until every expected flog is
+// present in the stream's Parquet files, then returns all persisted rows in
+// the order `downloadParquetFiles` and the Parquet reader produce them.
+func waitForPersistedFlogs(t *testing.T, stream string, config MinIoConfig, workDir string, expected []Flog, timeout, interval, attemptTimeout time.Duration) []Flog {
+	t.Helper()
+	var persisted []Flog
+	lastReason := ""
+	opts := readiness.Options{
+		Timeout:        timeout,
+		Interval:       interval,
+		AttemptTimeout: attemptTimeout,
+		OnRetry: func(attempt int, err error) {
+			if reason := err.Error(); reason != lastReason {
+				t.Logf("integrity: persisted data not ready (attempt %d): %s", attempt, reason)
+				lastReason = reason
+			}
+		},
+	}
+	attempts, err := readiness.Wait(context.Background(), opts, func(ctx context.Context) error {
+		attemptDir, err := os.MkdirTemp(workDir, "parquet-")
+		if err != nil {
+			return readiness.Permanent(err)
+		}
+		defer os.RemoveAll(attemptDir)
+
+		parquetFiles, err := downloadParquetFiles(ctx, stream, config, attemptDir)
+		if err != nil {
+			return err
+		}
+		if len(parquetFiles) == 0 {
+			return fmt.Errorf("no parquet files under %s/%s yet", config.Bucket, stream)
+		}
+		rows, err := loadFlogsFromParquetFiles(parquetFiles)
+		if err != nil {
+			return err
+		}
+		if missing := readiness.Missing(expected, rows); len(missing) > 0 {
+			return fmt.Errorf("%d of %d expected records missing from %d persisted rows in %d parquet files",
+				len(missing), len(expected), len(rows), len(parquetFiles))
+		}
+		persisted = rows
+		return nil
+	})
+	require.NoErrorf(t, err, "ingested records were not persisted to Parquet within %s (+%s attempt grace)", timeout, attemptTimeout)
+	t.Logf("integrity: all %d records persisted after %d attempts", len(expected), attempts)
+	return persisted
+}
