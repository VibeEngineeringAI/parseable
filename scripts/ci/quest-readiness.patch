+// Package readiness replaces fixed sleeps with bounded polling. A check
+// reports why it is not ready yet, or wraps the error with Permanent to stop
+// waiting immediately (for example, rejected credentials).
+package readiness
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// Check returns nil once ready. Any other error is retried until the
+// deadline, unless it is wrapped with Permanent. Checks must pass ctx to all
+// I/O they perform: it carries the per-attempt deadline.
+type Check func(ctx context.Context) error
+
+type Options struct {
+	// Timeout bounds when attempts may start. The final attempt starts at the
+	// deadline, so polling never gives up earlier than an equivalent fixed
+	// sleep followed by a single check.
+	Timeout  time.Duration
+	Interval time.Duration
+	// AttemptTimeout bounds each attempt through its context, including one
+	// that is still in flight at the deadline. A wait therefore takes at most
+	// Timeout + AttemptTimeout; that grace is what lets the final attempt run
+	// at the deadline instead of being cut short by it.
+	AttemptTimeout time.Duration
+	// OnRetry, when set, is called after each not-ready attempt.
+	OnRetry func(attempt int, err error)
+
+	now   func() time.Time
+	sleep func(ctx context.Context, d time.Duration) error
+}
+
+type permanentError struct{ err error }
+
+func (e *permanentError) Error() string { return e.err.Error() }
+func (e *permanentError) Unwrap() error { return e.err }
+
+// Permanent marks err as non-retryable.
+func Permanent(err error) error {
+	if err == nil {
+		return nil
+	}
+	return &permanentError{err: err}
+}
+
+func IsPermanent(err error) bool {
+	var permanent *permanentError
+	return errors.As(err, &permanent)
+}
+
+// TimeoutError reports the last reason the check was not ready.
+type TimeoutError struct {
+	Attempts int
+	Elapsed  time.Duration
+	Last     error
+}
+
+func (e *TimeoutError) Error() string {
+	return fmt.Sprintf("not ready after %d attempts in %s: %v", e.Attempts, e.Elapsed.Round(time.Millisecond), e.Last)
+}
+
+func (e *TimeoutError) Unwrap() error { return e.Last }
+
+// Wait runs check until it succeeds, returns a permanent error, ctx is done,
+// or opts.Timeout elapses. It returns the number of attempts made. An attempt
+// that ends because its own AttemptTimeout expired is retried like any other
+// not-ready result.
+func Wait(ctx context.Context, opts Options, check Check) (int, error) {
+	if opts.Timeout <= 0 || opts.Interval <= 0 || opts.AttemptTimeout <= 0 {
+		return 0, errors.New("readiness: Timeout, Interval and AttemptTimeout must be positive")
+	}
+	now := opts.now
+	if now == nil {
+		now = time.Now
+	}
+	sleep := opts.sleep
+	if sleep == nil {
+		sleep = sleepContext
+	}
+
+	start := now()
+	deadline := start.Add(opts.Timeout)
+	for attempt := 1; ; attempt++ {
+		attemptCtx, cancel := context.WithTimeout(ctx, opts.AttemptTimeout)
+		err := check(attemptCtx)
+		cancel()
+		if err == nil {
+			return attempt, nil
+		}
+		if IsPermanent(err) {
+			return attempt, err
+		}
+		if ctx.Err() != nil {
+			return attempt, fmt.Errorf("readiness wait cancelled after %d attempts: %w (last: %v)", attempt, ctx.Err(), err)
+		}
+		current := now()
+		if !current.Before(deadline) {
+			return attempt, &TimeoutError{Attempts: attempt, Elapsed: current.Sub(start), Last: err}
+		}
+		if opts.OnRetry != nil {
+			opts.OnRetry(attempt, err)
+		}
+		delay := opts.Interval
+		if remaining := deadline.Sub(current); remaining < delay {
+			delay = remaining
+		}
+		if err := sleep(ctx, delay); err != nil {
+			return attempt, fmt.Errorf("readiness wait cancelled after %d attempts: %w", attempt, err)
+		}
+	}
+}
+
+func sleepContext(ctx context.Context, d time.Duration) error {
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+// HTTPStatus converts a non-200 response into a readiness error. Rejected
+// credentials or permissions are permanent; anything else may be transient
+// while data is being synced.
+func HTTPStatus(what string, status int, body string) error {
+	if status == http.StatusOK {
+		return nil
+	}
+	err := fmt.Errorf("%s returned HTTP %d: %s", what, status, truncate(body))
+	if status == http.StatusUnauthorized || status == http.StatusForbidden {
+		return Permanent(err)
+	}
+	return err
+}
+
+// pbErrorEnvelope is the error pb prints with `-o json`, for example
+// {"error":{"code":"AUTH_FAILED","http_status":401,...}}.
+type pbErrorEnvelope struct {
+	Error *pbError `json:"error"`
+}
+
+type pbError struct {
+	Code       string `json:"code"`
+	HTTPStatus int    `json:"http_status"`
+}
+
+var pbPermanentCodes = map[string]bool{"AUTH_FAILED": true, "PERMISSION_DENIED": true}
+
+// Bare status codes are not matched: generated stream names may contain them.
+var authFailureMarkers = []string{"unauthorized", "forbidden"}
+
+// CommandFailure converts a failed pb invocation into a readiness error,
+// treating authentication or authorization failures as permanent.
+func CommandFailure(what string, err error, stdout, stderr string) error {
+	if err == nil {
+		return nil
+	}
+	wrapped := fmt.Errorf("%s failed: %w (stdout=%q, stderr=%q)", what, err, truncate(stdout), truncate(stderr))
+	for _, output := range []string{stdout, stderr} {
+		if envelope, ok := parsePBError(output); ok {
+			if pbPermanentCodes[envelope.Code] ||
+				envelope.HTTPStatus == http.StatusUnauthorized || envelope.HTTPStatus == http.StatusForbidden {
+				return Permanent(wrapped)
+			}
+			return wrapped
+		}
+	}
+	output := strings.ToLower(stdout + "\n" + stderr)
+	for _, marker := range authFailureMarkers {
+		if strings.Contains(output, marker) {
+			return Permanent(wrapped)
+		}
+	}
+	return wrapped
+}
+
+// parsePBError decodes the first JSON object in output, skipping any
+// progress-spinner text pb writes before it.
+func parsePBError(output string) (pbError, bool) {
+	start := strings.Index(output, "{")
+	if start < 0 {
+		return pbError{}, false
+	}
+	var envelope pbErrorEnvelope
+	if err := json.NewDecoder(strings.NewReader(output[start:])).Decode(&envelope); err != nil || envelope.Error == nil {
+		return pbError{}, false
+	}
+	return *envelope.Error, true
+}
+
+// Missing returns the expected items that are absent from actual, treating
+// both slices as multisets so duplicated expected items must all be present.
+func Missing[T comparable](expected, actual []T) []T {
+	available := make(map[T]int, len(actual))
+	for _, item := range actual {
+		available[item]++
+	}
+	var missing []T
+	for _, item := range expected {
+		if available[item] > 0 {
+			available[item]--
+			continue
+		}
+		missing = append(missing, item)
+	}
+	return missing
+}
+
+func truncate(s string) string {
+	const limit = 512
+	if len(s) <= limit {
+		return s
+	}
+	return s[:limit] + "..."
+}
